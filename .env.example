# Copy this file to .env.local to connect a real backend.

# Base URL of your REST API (no trailing slash)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Set to "false" to stop using mock data and call VITE_API_BASE_URL instead.
# Defaults to "true" (mock mode) if unset, so the app runs standalone out of the box.
VITE_USE_MOCK=true
